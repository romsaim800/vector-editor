<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Vector Editor Test</title>
<style>
  body { margin: 0; font-family: sans-serif; }
  p { margin: 0; padding: 12px; background: #eee; }
  svg { display: block; width: 100vw; height: calc(100vh - 44px); touch-action: none; }
</style>
</head>
<body>
<p>স্ক্রিনে আঙুল দিয়ে ট্যাপ করুন, বৃত্ত আসবে।</p>
<svg id="c"></svg>
<script>
  var svg = document.getElementById("c");
  svg.addEventListener("pointerdown", function (e) {
    var r = svg.getBoundingClientRect();
    var circle = document.createElementNS("http://www.w3.org/2000/svg", "circle");
    circle.setAttribute("cx", e.clientX - r.left);
    circle.setAttribute("cy", e.clientY - r.top);
    circle.setAttribute("r", 24);
    circle.setAttribute("fill", "hsl(" + Math.floor(Math.random() * 360) + ",70%,55%)");
    svg.appendChild(circle);
  });
</script>
</body>
</html>
